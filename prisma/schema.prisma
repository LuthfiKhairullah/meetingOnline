generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int       @id @default(autoincrement())
  publicId            String    @unique(map: "User_publicId_key")
  username            String    @db.VarChar(30)  @unique(map: "User_username_key")
  fullname            String    @db.VarChar(100)
  email               String?
  emailHash           String?
  password            String
  nik                 String?   @db.VarChar(6)
  alamat              String?   @db.Text
  noHp                String?   @db.VarChar(14)
  otp                 String?
  otpExpired          DateTime?
  userActivationId    Int
  userTypeId          String?   @db.VarChar(36)

  userDevice        UserDevice[]        @relation("UserDeviceUserId")
  verificationUser  VerificationUser[]  @relation("VerificationUserUserId")
  userRole          UserRole[]          @relation("UserRoleUserId")
  murajaah          Murajaah[]          @relation("MurajaahUserId")
  teacher           Teacher[]           @relation("TeacherUserId")
  courseStudent     CourseStudent[]     @relation("CourseStudentUserId")
  notification      Notification[]      @relation("NotificationUserId")
  userActivation    UserActivation      @relation("UserActivationUserActivationId", fields: [userActivationId], references: [id])

  tasksCreated      Task[] @relation("TaskCreatedById")
  tasksUpdated      Task[] @relation("TaskUpdatedById")
  tasksDeleted      Task[] @relation("TaskDeletedById")
  
  murajaahCreated   Murajaah[] @relation("MurajaahCreatedById")
  murajaahDeleted   Murajaah[] @relation("MurajaahDeletedById")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userTypeId])
}

model UserActivation {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(14)
  deletedAt DateTime?

  users       User[]    @relation("UserActivationUserActivationId")
}


model UserDevice {
  id            Int    @id @default(autoincrement())
  publicId      String    @unique(map: "UserDevice_publicId_key")

  userId      Int
  deviceId    String
  tokenId     String      @db.Text
  platform    String      @db.VarChar(10)

  user        User        @relation("UserDeviceUserId", fields: [userId], references: [id])

  deletedAt   DateTime?
  @@index([userId])
}

model VerificationUser {
  id          Int       @id @default(autoincrement())
  userId      Int
  otp         String

  verificationAt  DateTime?
  createdAt  DateTime?
  expiredAt  DateTime?

  user   User @relation("VerificationUserUserId", fields: [userId], references: [id])
  
  deletedAt   DateTime?
  @@index([userId])
}

model UserRole {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int

  user   User @relation("UserRoleUserId", fields: [userId], references: [id])
  role   Role @relation("UserRoleRoleId", fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Role {
  id          Int   @id @default(autoincrement())
  publicId    String   @unique(map: "Role_publicId_key")
  name        String   @unique(map: "Role_name_key") @db.VarChar(8)
  deletedAt DateTime?

  userRole        UserRole[]        @relation("UserRoleRoleId")
  rolePermission  RolePermission[]  @relation("RolePermissionRoleId")
}

model RolePermission {
  id           Int  @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role         Role         @relation("RolePermissionRoleId", fields: [roleId], references: [id])
  permission   Permission   @relation("RolePermissionPermissionId", fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Permission {
  id   Int    @id       @default(autoincrement())
  code String @unique   @db.VarChar(50)
  name String @db.VarChar(50)

  rolePermission  RolePermission[]    @relation("RolePermissionPermissionId")
}

model Murajaah {
  id            Int       @id @default(autoincrement())
  publicId      String    @unique(map: "Murajaah_publicId_key")

  taskId        Int
  userId        Int
  date          DateTime
  timezone      String   @default("Asia/Jakarta")

  createdById   Int
  deletedById   Int?

  user          User      @relation("MurajaahUserId", fields: [userId], references: [id])
  createdBy     User      @relation("MurajaahCreatedById", fields: [createdById], references: [id])
  deletedBy     User?     @relation("MurajaahDeletedById", fields: [deletedById], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model MurajaahScore {
  id            Int       @id @default(autoincrement())
  
  murajaahId    Int
  score         Float
  doneAt        DateTime
  timezone      String   @default("Asia/Jakarta")
  answer        String
  answerFile    String
  revAnswerId   Int
  revScoreId    Int

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model Task {
  id        Int     @id @default(autoincrement())
  publicId  String  @unique(map: "Task_publicId_key")

  courseTeacherId   Int
  categoryTaskId    Int
  title             String  @db.VarChar(100)
  description       String?
  
  meetingUrl        String?
  location          String?
  revTaskId         Int?
  startAt           DateTime
  endAt             DateTime
  timezone          String   @default("Asia/Jakarta")

  createdById   Int
  updatedById   Int
  deletedById   Int?

  courseTeacher    CourseTeacher     @relation("TaskCourseTeacherId", fields: [courseTeacherId], references: [id])
  categoryTask     CategoryTask      @relation("TaskCategoryTaskId", fields: [categoryTaskId], references: [id])
  
  createdBy     User      @relation("TaskCreatedById", fields: [createdById], references: [id])
  updatedBy     User      @relation("TaskUpdatedById", fields: [updatedById], references: [id])
  deletedBy     User?     @relation("TaskDeletedById", fields: [deletedById], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  notification  Notification[]   @relation("NotificationTaskId")
}

model TaskScore {
  id        Int    @id @default(autoincrement())

  taskId            Int
  courseStudentId   Int
  score             Float?
  doneAt            DateTime
  answer            String?
  answerFile        String?
  revAnswerId       Int?
  revScoreId        Int?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  revScore        TaskScore                 @relation("TaskScoreRevScoreId", fields: [revScoreId], references: [id])
  courseStudent   CourseStudent             @relation("TaskScoreCourseStudentId", fields: [courseStudentId], references: [id])
}

model CategoryTask {
  id          Int   @id @default(autoincrement())
  publicId    String   @unique(map: "CategoryTask_publicId_key")
  name        String   @unique @db.VarChar(30)
  deletedAt DateTime?

  notification  Notification[]   @relation("NotificationCategoryTaskId")
  task  Task[]   @relation("TaskCategoryTaskId")
}

model Class {
  id          Int   @id @default(autoincrement())
  publicId    String   @unique(map: "Class_publicId_key")
  name        String   @unique @db.VarChar(30)
  deletedAt   DateTime?

  teacher         Teacher[]         @relation("TeacherClassId")
  courseTeacher   CourseTeacher[]   @relation("CourseTeacherClassId")
}

model Course {
  id          Int   @id @default(autoincrement())
  publicId    String   @unique(map: "Course_publicId_key")
  name        String   @unique @db.VarChar(30)
  deletedAt   DateTime?

  courseTeacher     CourseTeacher[]   @relation("CourseTeacherCourseId")
}

model Teacher {
  id          Int   @id @default(autoincrement())
  publicId    String   @unique(map: "Teacher_publicId_key")
  
  classId     Int
  userId      Int

  deletedAt DateTime?

  class           Class             @relation("TeacherClassId", fields: [classId], references: [id])
  user            User              @relation("TeacherUserId", fields: [userId], references: [id])
  courseTeacher   CourseTeacher[]   @relation("CourseTeacherTeacherId")
}

model CourseTeacher {
  id          Int   @id @default(autoincrement())
  publicId    String   @unique(map: "CourseTeacher_publicId_key")
  
  courseId    Int
  teacherId   Int
  classId     Int
  deletedAt   DateTime?

  course      Course    @relation("CourseTeacherCourseId", fields: [courseId], references: [id])
  teacher     Teacher   @relation("CourseTeacherTeacherId", fields: [teacherId], references: [id])
  class       Class     @relation("CourseTeacherClassId", fields: [classId], references: [id])
  task        Task[]    @relation("TaskCourseTeacherId")
  courseStudent     CourseStudent[]   @relation("CourseStudentCourseTeacherId")
}

model CourseStudent {
  id          Int   @id @default(autoincrement())
  publicId    String   @unique(map: "CourseStudent_publicId_key")
  
  courseTeacherId   Int
  userId            Int
  deletedAt   DateTime?

  courseTeacher   CourseTeacher  @relation("CourseStudentCourseTeacherId", fields: [courseTeacherId], references: [id])
  user            User    @relation("CourseStudentUserId", fields: [userId], references: [id])
}

model Notification {
  id          Int     @id @default(autoincrement())
  publicId    String  @unique(map: "Notification_publicId_key")

  title       String
  description String?
  sendAt      DateTime
  openAt      DateTime?
  timezone    String   @default("Asia/Jakarta")

  categoryNotificationId    Int
  categoryTaskId            Int?
  taskId                    Int?
  userId                    Int
  
  categoryNotification  CategoryNotification  @relation("NotificationCategoryNotificationId", fields: [categoryNotificationId], references: [id])
  categoryTask          CategoryTask?         @relation("NotificationCategoryTaskId", fields: [categoryTaskId], references: [id])
  task                  Task?                 @relation("NotificationTaskId", fields: [taskId], references: [id])
  user                  User                  @relation("NotificationUserId", fields: [userId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model CategoryNotification {
  id          Int   @id @default(autoincrement())
  name        String   @unique @db.VarChar(30)
  deletedAt   DateTime?

  notification   Notification[]   @relation("NotificationCategoryNotificationId")
}